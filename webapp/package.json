{
	"name": "campfire-webapp",
	"version": "1.4.2",
	"description": "React 19 webapp bundle for the Campfire Mattermost plugin.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite build --watch --mode development",
		"build": "vite build && node scripts/verify-bundle.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
		"format": "prettier --write src scripts",
		"format:check": "prettier --check src scripts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.107.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.73.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@eslint/js": "^10.0.0",
		"@rolldown/plugin-babel": "^0.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/react": "^16.3.3",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vite-plugin-css-injected-by-js": "^3.5.2",
		"vitest": "^5.1.0"
	}
}
